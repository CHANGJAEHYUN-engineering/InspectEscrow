{
  "$defs": {
    "address": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "type": "string"
    },
    "bytes32": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "nonEmptyObject": {
      "minProperties": 1,
      "type": "object"
    }
  },
  "$id": "https://inspectescrow.example/schemas/inspection-policy-v1.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ai": {
      "additionalProperties": false,
      "properties": {
        "bundleManifestSchema": {
          "const": "inspectescrow.model-bundle-manifest/1.0.0"
        },
        "bundleMustCommit": {
          "items": {
            "type": "string"
          },
          "minItems": 10,
          "type": "array",
          "uniqueItems": true
        },
        "calibrationManifestHash": {
          "$ref": "#/$defs/bytes32"
        },
        "calibrationSelectionRule": {
          "type": "object"
        },
        "method": {
          "const": "PatchCore"
        },
        "modelBundleHash": {
          "$ref": "#/$defs/bytes32"
        },
        "replayToleranceScaled": {
          "const": 222
        },
        "requiredViewAggregation": {
          "const": "SINGLE_SOURCE_VIEW_RAW_PATCHCORE_SCORE"
        },
        "scoreMaximumScaled": {
          "const": "340282366920938463463374607431768211455",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "scoreMinimumScaled": {
          "const": 0
        },
        "scoreNormalization": {
          "const": "NONE"
        },
        "scoreRangeJsonEncoding": {
          "const": "UINT128_MAX_AS_EXACT_DECIMAL_STRING_FOR_RFC8785"
        },
        "scoreScaleExponent": {
          "const": 6
        },
        "scoreSchemaId": {
          "$ref": "#/$defs/bytes32"
        },
        "scoreSchemaName": {
          "const": "PATCHCORE_AGGREGATE_SCORE_V1"
        },
        "scoreTransformingPostprocessing": {
          "const": "NONE"
        },
        "semanticLimit": {
          "const": "ADMISSIBLE_REVIEW_IS_NOT_AUTOMATIC_PROOF_OF_DEFECT"
        },
        "stationVerdictAuthoritative": {
          "const": false
        },
        "thresholdScaled": {
          "const": 57904037
        },
        "thresholdSource": {
          "const": "FROZEN_VALIDATION_CALIBRATION_MANIFEST"
        },
        "verdictRule": {
          "const": "CONTRACT_DERIVES_PASS_IF_SCORE_LT_THRESHOLD_ELSE_REVIEW"
        }
      },
      "required": [
        "method",
        "modelBundleHash",
        "bundleManifestSchema",
        "bundleMustCommit",
        "calibrationManifestHash",
        "calibrationSelectionRule",
        "scoreSchemaName",
        "scoreSchemaId",
        "scoreScaleExponent",
        "scoreMinimumScaled",
        "scoreMaximumScaled",
        "thresholdScaled",
        "thresholdSource",
        "verdictRule",
        "stationVerdictAuthoritative",
        "requiredViewAggregation",
        "replayToleranceScaled",
        "scoreNormalization",
        "scoreTransformingPostprocessing",
        "semanticLimit",
        "scoreRangeJsonEncoding"
      ],
      "type": "object"
    },
    "attestation": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "capture": {
      "additionalProperties": false,
      "properties": {
        "arbitraryDistanceOrImageCount": {
          "const": "NOT_FROZEN"
        },
        "captureProfileHash": {
          "$ref": "#/$defs/bytes32"
        },
        "captureProfileVersion": {
          "const": 1
        },
        "humidity": {
          "const": "REMOVED_FROM_DEFAULT_MVP"
        },
        "lux": {
          "const": "NO_INDEPENDENT_VALIDITY_RULE_UNLESS_VALIDATED"
        },
        "numericToleranceRule": {
          "const": "PROMOTE_ONLY_AFTER_SENSITIVITY_EXPERIMENT_SHOWS_MATERIAL_SCORE_EFFECT"
        },
        "physicalCameraMetadataClaimed": {
          "const": false
        },
        "productionCaptureProfileClaimed": {
          "const": false
        },
        "profileCommits": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "requiredViewCount": {
          "const": 1
        },
        "requiredViewSetHash": {
          "$ref": "#/$defs/bytes32"
        },
        "temperature": {
          "const": "REMOVED_FROM_DEFAULT_MVP"
        }
      },
      "required": [
        "captureProfileHash",
        "captureProfileVersion",
        "requiredViewSetHash",
        "requiredViewCount",
        "profileCommits",
        "numericToleranceRule",
        "temperature",
        "humidity",
        "lux",
        "arbitraryDistanceOrImageCount",
        "physicalCameraMetadataClaimed",
        "productionCaptureProfileClaimed"
      ],
      "type": "object"
    },
    "evidence": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "future": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "hashing": {
      "additionalProperties": false,
      "properties": {
        "canonicalization": {
          "const": "RFC8785-JCS"
        },
        "hashAlgorithm": {
          "const": "keccak256"
        },
        "integrationClarificationHash": {
          "$ref": "#/$defs/bytes32"
        },
        "policyHash": {
          "$ref": "#/$defs/bytes32"
        },
        "policyHashRule": {
          "const": "ZERO_POLICY_HASH_PREIMAGE_V1"
        }
      },
      "required": [
        "canonicalization",
        "hashAlgorithm",
        "policyHashRule",
        "policyHash",
        "integrationClarificationHash"
      ],
      "type": "object"
    },
    "policyId": {
      "$ref": "#/$defs/bytes32"
    },
    "policyVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "procedure": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "product": {
      "additionalProperties": false,
      "properties": {
        "datasetAnomalyLabelsAreContractDefects": {
          "const": false
        },
        "lotIdentityScheme": {
          "minLength": 1,
          "type": "string"
        },
        "productClass": {
          "minLength": 1,
          "type": "string"
        },
        "productRevision": {
          "minLength": 1,
          "type": "string"
        },
        "productSpecificationHash": {
          "$ref": "#/$defs/bytes32"
        },
        "productionSpecificationClaimed": {
          "const": false
        },
        "specimenIdentity": {
          "additionalProperties": false,
          "properties": {
            "bindTradeId": {
              "const": true
            },
            "canonicalSpecimenManifestRequired": {
              "const": true
            },
            "captureSessionNonceRequired": {
              "const": true
            },
            "claimLimit": {
              "const": "STRENGTHENS_TRACEABILITY_BUT_DOES_NOT_PREVENT_PHYSICAL_SUBSTITUTION"
            },
            "completeSessionFileListRequired": {
              "const": true
            },
            "identifierRequiredInOverviewImage": {
              "const": false
            },
            "physicalCustodyProofClaimed": {
              "const": false
            },
            "requiredViewSetHash": {
              "$ref": "#/$defs/bytes32"
            },
            "samePhysicalSupplierBuyerItemClaimed": {
              "const": false
            },
            "scheme": {
              "const": "PUBLIC_DATASET_SOURCE_FILE_BINDING"
            },
            "specimenIdFormat": {
              "const": "DATASET_RELATIVE_PATH_PLUS_EXACT_SOURCE_DIGEST"
            }
          },
          "required": [
            "scheme",
            "specimenIdFormat",
            "bindTradeId",
            "identifierRequiredInOverviewImage",
            "requiredViewSetHash",
            "captureSessionNonceRequired",
            "completeSessionFileListRequired",
            "canonicalSpecimenManifestRequired",
            "samePhysicalSupplierBuyerItemClaimed",
            "physicalCustodyProofClaimed",
            "claimLimit"
          ],
          "type": "object"
        }
      },
      "required": [
        "productClass",
        "productRevision",
        "productSpecificationHash",
        "lotIdentityScheme",
        "productionSpecificationClaimed",
        "datasetAnomalyLabelsAreContractDefects",
        "specimenIdentity"
      ],
      "type": "object"
    },
    "protocol": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "replay": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "schema": {
      "const": "inspectescrow.inspection-policy"
    },
    "schemaVersion": {
      "const": "1.1.0"
    },
    "settlement": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "stateRules": {
      "$ref": "#/$defs/nonEmptyObject"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "CANCELLED"
      ]
    },
    "trade": {
      "additionalProperties": false,
      "properties": {
        "backupInspectorWallet": {
          "$ref": "#/$defs/address"
        },
        "buyerStationSigner": {
          "$ref": "#/$defs/address"
        },
        "buyerWallet": {
          "$ref": "#/$defs/address"
        },
        "chainId": {
          "const": 11155111
        },
        "escrowAmountBaseUnits": {
          "minimum": 1,
          "type": "integer"
        },
        "inspectorStationSigner": {
          "$ref": "#/$defs/address"
        },
        "primaryInspectorWallet": {
          "$ref": "#/$defs/address"
        },
        "settlementAsset": {
          "const": "NATIVE_SEPOLIA_ETH"
        },
        "supplierStationSigner": {
          "$ref": "#/$defs/address"
        },
        "supplierWallet": {
          "$ref": "#/$defs/address"
        },
        "tradeId": {
          "$ref": "#/$defs/bytes32"
        },
        "verifyingContract": {
          "$ref": "#/$defs/address"
        }
      },
      "required": [
        "tradeId",
        "chainId",
        "verifyingContract",
        "supplierWallet",
        "buyerWallet",
        "primaryInspectorWallet",
        "backupInspectorWallet",
        "supplierStationSigner",
        "buyerStationSigner",
        "inspectorStationSigner",
        "settlementAsset",
        "escrowAmountBaseUnits"
      ],
      "type": "object"
    },
    "versioning": {
      "$ref": "#/$defs/nonEmptyObject"
    }
  },
  "required": [
    "schema",
    "schemaVersion",
    "status",
    "policyId",
    "policyVersion",
    "hashing",
    "trade",
    "product",
    "ai",
    "capture",
    "attestation",
    "evidence",
    "protocol",
    "procedure",
    "stateRules",
    "replay",
    "settlement",
    "versioning",
    "future"
  ],
  "title": "InspectEscrow Inspection Policy v1.1",
  "type": "object"
}